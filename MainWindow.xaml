<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TodoApp"
        Title="Todo" Height="520" Width="480" MinHeight="300" MinWidth="400"
        PreviewMouseDown="Window_PreviewMouseDown">
    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Recurring tasks..." Click="Recurring_Click"/>
                <MenuItem Header="_Archive..." Click="Archive_Click"/>
                <MenuItem Header="_Calendar..." Click="Calendar_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <DockPanel Margin="10">

            <!-- add row: the date and time are when a one-off task is due, or when a
                 repeating one starts and the time of day it comes back -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTitle" Grid.Column="0" VerticalContentAlignment="Center"
                         KeyDown="NewEntry_KeyDown"/>
                <DatePicker x:Name="NewDue" Grid.Column="1" Width="110" Margin="4,0,0,0"
                            ToolTip="Due date, or when a repeating task starts (blank = today)"/>
                <TextBox x:Name="NewTime" Grid.Column="2" Width="60" Margin="4,0,0,0"
                         VerticalContentAlignment="Center" KeyDown="NewEntry_KeyDown"
                         ToolTip="Time of day, e.g. 14:30. For a repeating task, the time it comes back."/>
                <ComboBox x:Name="NewRepeat" Grid.Column="3" Width="80" Margin="4,0,0,0"
                          ToolTip="How often it repeats"/>
                <Button Grid.Column="4" Content="Add" Width="45" Margin="6,0,0,0" Click="Add_Click"/>
            </Grid>

            <TextBlock x:Name="EmptyNote" DockPanel.Dock="Bottom" Margin="2,6,0,0"
                       FontSize="10" Foreground="Gray" Text=""/>

            <!-- Rows are picked by type: recurring tasks and one-off todos each
                 have their own template below. -->
            <ListBox x:Name="List" HorizontalContentAlignment="Stretch"
                     BorderBrush="Gray" BorderThickness="1">
                <ListBox.Resources>

                    <DataTemplate DataType="{x:Type local:RecurringTask}">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="2,2,8,0"
                                      ToolTip="Done for now; comes back when it's next due"
                                      Click="RecurringDone_Click"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                           Foreground="{StaticResource RecurringAccent}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="edit" FontSize="10" Width="34" Height="20"
                                    VerticalAlignment="Top" Margin="6,0,2,0" Click="RecurringEdit_Click"/>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type local:TodoItem}">
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="2,2,8,0"
                                      ToolTip="Check off and archive" Click="Done_Click"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DueText}" FontSize="10" Foreground="{Binding DueColor}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="edit" FontSize="10" Width="34" Height="20"
                                    VerticalAlignment="Top" Margin="6,0,2,0" Click="Edit_Click"/>
                        </Grid>
                    </DataTemplate>

                </ListBox.Resources>
            </ListBox>

        </DockPanel>
    </DockPanel>
</Window>
