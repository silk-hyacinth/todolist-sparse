<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo" Height="520" Width="440" MinHeight="300" MinWidth="360"
        PreviewMouseDown="Window_PreviewMouseDown">
    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Archive..." Click="Archive_Click"/>
                <MenuItem Header="_Calendar..." Click="Calendar_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <DockPanel Margin="10">

            <!-- add row -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTitle" Grid.Column="0" VerticalContentAlignment="Center"
                         KeyDown="NewEntry_KeyDown"/>
                <DatePicker x:Name="NewDue" Grid.Column="1" Width="110" Margin="4,0,0,0"/>
                <TextBox x:Name="NewTime" Grid.Column="2" Width="55" Margin="4,0,0,0"
                         VerticalContentAlignment="Center" KeyDown="NewEntry_KeyDown"
                         ToolTip="Time of day, e.g. 14:30"/>
                <Button Grid.Column="3" Content="Add" Width="45" Margin="4,0,0,0" Click="Add_Click"/>
            </Grid>

            <TextBlock x:Name="EmptyNote" DockPanel.Dock="Bottom" Margin="2,6,0,0"
                       FontSize="10" Foreground="Gray" Text=""/>

            <ListBox x:Name="List" ItemsSource="{Binding}" HorizontalContentAlignment="Stretch"
                     BorderBrush="Gray" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="2,2,8,0"
                                      ToolTip="Check off and archive" Click="Done_Click"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DueText}" FontSize="10" Foreground="{Binding DueColor}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="edit" FontSize="10" Width="34" Height="20"
                                    VerticalAlignment="Top" Margin="6,0,0,0" Click="Edit_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </DockPanel>
    </DockPanel>
</Window>
