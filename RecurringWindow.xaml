<Window x:Class="TodoApp.RecurringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recurring tasks" Height="420" Width="440" MinHeight="250" MinWidth="360"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock x:Name="Note" DockPanel.Dock="Bottom" Margin="2,6,0,0"
                   FontSize="10" Foreground="Gray" Text=""/>
        <!-- not synced to the view's current item, or the first row starts out selected -->
        <ListBox x:Name="List" HorizontalContentAlignment="Stretch" IsSynchronizedWithCurrentItem="False"
                 BorderBrush="Gray" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- anything not due right now (done, or not started) is greyed out -->
                        <StackPanel Grid.Column="0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDue}" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="10"
                                       Foreground="{StaticResource RecurringAccent}"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="undo" FontSize="10" Width="38" Height="20"
                                VerticalAlignment="Top" Margin="6,0,0,0"
                                ToolTip="Not done after all; puts it back on the list now"
                                Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}"
                                Click="Undo_Click"/>
                        <Button Grid.Column="2" Content="edit" FontSize="10" Width="34" Height="20"
                                VerticalAlignment="Top" Margin="4,0,0,0" Click="Edit_Click"/>
                        <Button Grid.Column="3" Content="delete" FontSize="10" Width="42" Height="20"
                                VerticalAlignment="Top" Margin="4,0,2,0"
                                ToolTip="Stop repeating; moves it to the archive, where it can be restored"
                                Click="Delete_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
