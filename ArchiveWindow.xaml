<Window x:Class="TodoApp.ArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Archive" Height="480" Width="420" MinHeight="250" MinWidth="320"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock x:Name="Note" DockPanel.Dock="Bottom" Margin="2,6,0,0"
                   FontSize="10" Foreground="Gray" Text=""/>
        <ListBox x:Name="List" HorizontalContentAlignment="Stretch"
                 BorderBrush="Gray" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="Gray"/>
                            <TextBlock Text="{Binding ArchiveText}" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="restore" FontSize="10" Width="48" Height="20"
                                VerticalAlignment="Top" Margin="6,0,0,0" Click="Restore_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
