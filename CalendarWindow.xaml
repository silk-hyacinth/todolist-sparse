<Window x:Class="TodoApp.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendar" Height="620" Width="720" MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="&lt;" Width="28" Click="Prev_Click"/>
            <TextBlock x:Name="MonthLabel" Grid.Column="1" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Today" Width="50" Click="Today_Click"/>
            <Button Grid.Column="3" Content="&gt;" Width="28" Margin="4,0,0,0" Click="Next_Click"/>
        </Grid>

        <UniformGrid x:Name="WeekHeader" DockPanel.Dock="Top" Columns="7" Rows="1" Margin="0,0,0,2"/>

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="No due date" FontSize="10" Foreground="Gray" Margin="0,8,0,2"/>
            <ListBox x:Name="NoDate" MaxHeight="110" BorderBrush="Gray" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      BorderBrush="Gray" BorderThickness="1,1,0,0">
            <ItemsControl x:Name="Days">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="0,0,1,1"
                                MinHeight="72" Padding="3">
                            <StackPanel>
                                <TextBlock Text="{Binding DayText}" FontSize="10"
                                           Foreground="{Binding DayColor}"
                                           FontWeight="{Binding DayWeight}"/>
                                <ItemsControl ItemsSource="{Binding Entries}" Margin="0,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="10"
                                                       TextWrapping="Wrap" Margin="0,0,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
