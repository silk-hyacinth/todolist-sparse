<Window x:Class="TodoApp.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit item" Height="170" Width="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="10">
        <TextBlock Text="Title" FontSize="10" Foreground="Gray"/>
        <TextBox x:Name="TitleBox" VerticalContentAlignment="Center" Margin="0,2,0,8"/>

        <TextBlock Text="Due date / time" FontSize="10" Foreground="Gray"/>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
            <DatePicker x:Name="DueBox" Width="130"/>
            <TextBox x:Name="TimeBox" Width="70" Margin="4,0,0,0"
                     VerticalContentAlignment="Center" ToolTip="Time of day, e.g. 14:30"/>
            <Button Content="Clear" Width="45" Margin="4,0,0,0" Click="Clear_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="65" IsCancel="True"/>
            <Button Content="Save" Width="65" Margin="6,0,0,0" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
